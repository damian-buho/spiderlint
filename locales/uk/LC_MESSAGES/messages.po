msgstr "Адреса сайту"

msgid "Size"
msgstr "Розмір"

msgid "Socket wait"
msgstr "Очікування сокета"

msgid "Something went wrong. Try again later."
msgstr "Щось пішло не так. Спробуйте пізніше."

msgid "Speed Index"
msgstr "Speed Index"

msgid "spiderlint report"
msgstr "Звіт spiderlint"

msgid "spiderlint — scan every page of a website"
msgstr "spiderlint — перевірка кожної сторінки сайту"

msgid "Standard"
msgstr "Стандартні"

msgid "Start a new scan"
msgstr "Почати нову перевірку"

msgid "Statistics"
msgstr "Статистика"

msgid "Status"
msgstr "Статус"

msgid "Style transfer"
msgstr "Передача стилів"

msgid "TCP connect"
msgstr "З’єднання TCP"

msgid "The basics over HTTP, on at most 25 pages"
msgstr "Основи через HTTP, не більше ніж на 25 сторінках"

msgid "The form could not be read. Try again."
msgstr "Не вдалося прочитати форму. Спробуйте ще раз."

msgid "The form was sent from another site. Open this page and try again."
msgstr "Форму надіслано з іншого сайту. Відкрийте цю сторінку та спробуйте ще раз."

msgid "The recommended checks"
msgstr "Рекомендовані перевірки"

msgid "The recommended checks plus link graph, structured data, manifest, trackers and more"
msgstr "Рекомендовані перевірки плюс граф посилань, структуровані дані, маніфест, трекери та інше"

msgid "The requested fetch mode is not available on this instance."
msgstr "Запитаний режим завантаження недоступний на цьому сервері."

msgid "The scan failed."
msgstr "Перевірка не вдалася."

msgid "The scan stays out of the latest reports and the badge. Anyone with its link can still open it."
msgstr "Перевірка не потрапить до останніх звітів і на значок. Той, хто має посилання, усе одно зможе її відкрити."

msgid "This instance does not scan this site."
msgstr "Цей сервер не перевіряє цей сайт."

msgid "This scan does not exist or has expired."
msgstr "Ця перевірка не існує або вже застаріла."

msgid "This site was scanned recently, so this is the existing report."
msgstr "Цей сайт нещодавно перевіряли, тож це наявний звіт."

msgid "This site was scanned recently, so this is the existing scan."
msgstr "Цей сайт нещодавно перевіряли, тож це наявна перевірка."

msgid "This site was scanned recently. Try again {when}."
msgstr "Цей сайт нещодавно перевіряли. Спробуйте ще раз {when}."

msgid "Time"
msgstr "Час"

msgid "Time to first byte"
msgstr "Час до першого байта"

msgid "TLS handshake"
msgstr "Рукостискання TLS"

msgid "Too many scans are waiting. Try again {when}."
msgstr "Забагато перевірок у черзі. Спробуйте ще раз {when}."

msgid "Total"
msgstr "Сума"

msgid "Total Blocking Time"
msgstr "Total Blocking Time"

msgid "Total time"
msgstr "Загальний час"

msgid "Transfer size"
msgstr "Обсяг передачі"

msgid "Vendor: {name}"
msgstr "Постачальник: {name}"

msgid "Waiting in the queue…"
msgstr "Очікує в черзі…"

msgid "Waits for domain, mail and certificates"
msgstr "Чекає на домен, пошту та сертифікати"

msgid "Waits for external links"
msgstr "Чекає на зовнішні посилання"

msgid "Waits for linked resources"
msgstr "Чекає на підключені ресурси"

msgid "Waits for the pages"
msgstr "Чекає на сторінки"

msgid "Waits for the whole site"
msgstr "Чекає на весь сайт"

msgid "Nothing to check"
msgstr "Нічого перевіряти"

msgid "Passed"
msgstr "Пройдено"

msgid "{severity}: {count}"
msgstr "{severity}: {count}"

msgid "Warning"
msgstr "Попередження"

msgid "Whole site"
msgstr "Весь сайт"

msgid "You can scan this site again now."
msgstr "Тепер ви можете перевірити цей сайт знову."

msgid "You have started many scans. Try again {when}."
msgstr "Ви запустили забагато перевірок. Спробуйте ще раз {when}."

msgid "{count} more"
msgstr "ще {count}"

msgid "{passed} of {total}"
msgstr "{passed} з {total}"

msgid "{phase}: {done} of {total}"
msgstr "{phase}: {done} з {total}"

msgid "Impact"
msgstr "Вплив"

msgid "Scope"
msgstr "Охоплення"

msgid "Check every page of a site: SEO tags, security headers, TLS, links and more."
msgstr "Перевіряє кожну сторінку сайту: SEO-теги, заголовки безпеки, TLS, посилання й інше."

msgid "Skip to main content"
msgstr "Перейти до основного вмісту"

msgid "Skipped: {count} rules"
msgstr "Пропущено: правил — {count}"

msgid "Findings"
msgstr "Знахідки"

msgid "Presets: {names}"
msgstr "Пресети: {names}"

msgid "From the cache, so a refreshed run reads them again:"
msgstr "З кешу; оновлений запуск прочитає їх знову:"

msgid "read {at}"
msgstr "прочитано {at}"

msgid "the slug is an identifier, not words"
msgstr "slug — ідентифікатор, а не слова"

msgid "the slug shares no word with the page title"
msgstr "slug не має жодного спільного слова із заголовком сторінки"

msgid "{label} is far above the median {median} of {count} pages"
msgstr "{label} значно перевищує медіану {median} для {count} сторінок"

msgid "{label} is far above the median {median} of {count} pages; the first alone outweighs the next {next} pages combined"
msgstr "{label} значно перевищує медіану {median} для {count} сторінок; перша сама переважує наступні {next} сторінок разом"

msgid "{label} is {common} on {count} of {total} pages, but not on these"
msgstr "{label}: {common} на {count} з {total} сторінок, але не на цих"

msgid "Not every rel=me profile links back to the site"
msgstr "Не всі профілі rel=me посилаються назад на сайт"

msgid "{label} varies across {host}"
msgstr "{label} відрізняється в межах {host}"

msgid "the link could not be reached: {error}"
msgstr "посилання недоступне: {error}"

msgid "the link answers {status}"
msgstr "посилання відповідає {status}"

msgid "<html lang> should be a BCP 47 language tag"
msgstr "<html lang> має бути мовним тегом BCP 47"

msgid "<meta charset> should declare UTF-8 within the first 1024 bytes"
msgstr "<meta charset> має оголошувати UTF-8 у перших 1024 байтах"

msgid "<meta name=tdm-reservation> should be 0 or 1"
msgstr "<meta name=tdm-reservation> має бути 0 або 1"

msgid "<title> repeats itself around a separator"
msgstr "<title> повторюється навколо роздільника"

msgid "<title> should be 30–60 characters"
msgstr "<title> має містити 30–60 символів"

msgid "a 503 should say when to retry with Retry-After"
msgstr "відповідь 503 має вказувати, коли повторити запит, через Retry-After"

msgid "Accept-CH breaks its structured-field grammar, so browsers ignore it"
msgstr "Accept-CH порушує граматику структурованого поля, тому браузери його ігнорують"

msgid "a compressed response should carry Vary: Accept-Encoding"
msgstr "стиснена відповідь має містити Vary: Accept-Encoding"

msgid "a JSON-LD block does not parse"
msgstr "блок JSON-LD не розбирається"

msgid "Alt-Svc breaks RFC 7838 §3, so clients never try the alternative"
msgstr "Alt-Svc порушує RFC 7838 §3, тому клієнти ніколи не пробують альтернативу"

msgid "Alt-Svc should advertise h3"
msgstr "Alt-Svc має оголошувати h3"

msgid "an <img> has no alt attribute"
msgstr "<img> не має атрибута alt"

msgid "an <img> without width and height shifts the layout as it loads"
msgstr "<img> без width і height зсуває макет під час завантаження"

msgid "an article gives no publication date for its link preview"
msgstr "стаття не вказує дату публікації для попереднього перегляду посилання"

msgid "an article names no author for its link preview"
msgstr "стаття не називає автора для попереднього перегляду посилання"

msgid "an article names no fediverse:creator account for Mastodon previews"
msgstr "стаття не називає облікового запису fediverse:creator для попереднього перегляду в Mastodon"

msgid "a page is more than 3 links away from the start page"
msgstr "сторінка віддалена від початкової більше ніж на 3 посилання"

msgid "a page links to no other page of the site"
msgstr "сторінка не посилається на жодну іншу сторінку сайту"

msgid "a page of a staging or development site is indexable"
msgstr "сторінка тестового або розробницького сайту індексується"

msgid "a page served off the canonical origin is indexable; mark the staging twin noindex"
msgstr "сторінка поза канонічним origin індексується; позначте її тестового двійника як noindex"

msgid "a page the sitemap lists says noindex, in <meta name=robots> or X-Robots-Tag"
msgstr "сторінка зі sitemap каже noindex у <meta name=robots> або X-Robots-Tag"

msgid "a preloaded resource went unused"
msgstr "попередньо завантажений ресурс не використано"

msgid "a redirect does not say which component sent it with Redirect-By"
msgstr "переспрямування не вказує через Redirect-By, який компонент його надіслав"

msgid "a right-to-left language should set <html dir=rtl>"
msgstr "мова справа наліво має задавати <html dir=rtl>"

msgid "a script in <head> without async, defer or type=module blocks rendering"
msgstr "скрипт у <head> без async, defer чи type=module блокує відображення"

msgid "a URL with a query has no No-Vary-Search to say which parameters change the page"
msgstr "URL із запитом не має No-Vary-Search, що вказував би, які параметри змінюють сторінку"

msgid "Cache-Control breaks RFC 9111 §5.2, and caches ignore what they cannot read"
msgstr "Cache-Control порушує RFC 9111 §5.2, а кеші ігнорують те, чого не можуть прочитати"

msgid "Cache-Control no-store keeps the page out of the back/forward cache"
msgstr "Cache-Control no-store виключає сторінку з кешу переходів назад/вперед"

msgid "Cache-Status breaks its structured-field grammar"
msgstr "Cache-Status порушує граматику структурованого поля"

msgid "canonical link should be an absolute URL"
msgstr "канонічне посилання має бути абсолютним URL"

msgid "certificate expires within 14 days"
msgstr "сертифікат спливає менш ніж за 14 днів"

msgid "certificate has expired"
msgstr "сертифікат прострочено"

msgid "certificate is not trusted"
msgstr "сертифікат не є довіреним"

msgid "certificate key is weaker than RSA 2048 or EC P-256"
msgstr "ключ сертифіката слабший за RSA 2048 або EC P-256"

msgid "Cloudflare’s Email Address Obfuscation rewrites every address into a link only JavaScript decodes, so a visitor without JavaScript sees no address"
msgstr "приховування адрес електронної пошти в Cloudflare перетворює кожну адресу на посилання, яке розшифровує лише JavaScript, тому відвідувач без JavaScript не бачить жодної адреси"

msgid "color-scheme names light and dark, but no theme-color pair carries a prefers-color-scheme media"
msgstr "color-scheme називає світлу й темну схеми, але жодна пара theme-color не має media prefers-color-scheme"

msgid "Content-Security-Policy allows eval() with 'unsafe-eval'"
msgstr "Content-Security-Policy дозволяє eval() через 'unsafe-eval'"

msgid "Content-Security-Policy allows inline scripts with 'unsafe-inline' and no nonce or hash"
msgstr "Content-Security-Policy дозволяє вбудовані скрипти через 'unsafe-inline' без nonce чи хеша"

msgid "Content-Security-Policy breaks CSP 3, and browsers drop what they cannot read"
msgstr "Content-Security-Policy порушує CSP 3, а браузери відкидають те, чого не можуть прочитати"

msgid "Content-Security-Policy lacks base-uri, so an injected <base> can redirect relative scripts"
msgstr "Content-Security-Policy не має base-uri, тому ін’єктований <base> може переспрямувати відносні скрипти"

msgid "Content-Security-Policy lacks frame-ancestors, which only a header can carry"
msgstr "Content-Security-Policy не має frame-ancestors, який може передати лише заголовок"

msgid "Content-Security-Policy lacks require-trusted-types-for 'script'"
msgstr "Content-Security-Policy не має require-trusted-types-for 'script'"

msgid "Content-Security-Policy lacks upgrade-insecure-requests"
msgstr "Content-Security-Policy не має upgrade-insecure-requests"

msgid "Content-Security-Policy loads scripts from any host through a * or scheme-only source"
msgstr "Content-Security-Policy завантажує скрипти з будь-якого хоста через джерело * або лише зі схемою"

msgid "Content-Security-Policy sets neither script-src nor default-src, so any script loads"
msgstr "Content-Security-Policy не задає ні script-src, ні default-src, тож завантажується будь-який скрипт"

msgid "Content-Security-Policy should set object-src 'none'"
msgstr "Content-Security-Policy має задавати object-src 'none'"

msgid "Content-Type breaks RFC 9110 §8.3.1"
msgstr "Content-Type порушує RFC 9110 §8.3.1"

msgid "Cross-Origin-Embedder-Policy breaks its structured-field grammar, so browsers ignore it"
msgstr "Cross-Origin-Embedder-Policy порушує граматику структурованого поля, тому браузери його ігнорують"

msgid "Cross-Origin-Embedder-Policy should be require-corp or credentialless"
msgstr "Cross-Origin-Embedder-Policy має бути require-corp або credentialless"

msgid "Cross-Origin-Opener-Policy breaks its structured-field grammar, so browsers ignore it"
msgstr "Cross-Origin-Opener-Policy порушує граматику структурованого поля, тому браузери його ігнорують"

msgid "Cross-Origin-Opener-Policy should be same-origin or same-origin-allow-popups"
msgstr "Cross-Origin-Opener-Policy має бути same-origin або same-origin-allow-popups"

msgid "Cross-Origin-Resource-Policy should be same-origin, same-site or cross-origin"
msgstr "Cross-Origin-Resource-Policy має бути same-origin, same-site або cross-origin"

msgid "Date should be an IMF-fixdate"
msgstr "Date має бути IMF-fixdate"

msgid "Deprecation should be @ and Unix seconds"
msgstr "Deprecation має бути @ і секундами Unix"

msgid "hreflang alternates should include x-default"
msgstr "альтернативи hreflang мають містити x-default"

msgid "internal links exist only after JavaScript runs"
msgstr "внутрішні посилання з’являються лише після виконання JavaScript"

msgid "Link breaks RFC 8288 §3, so clients drop the links they cannot read"
msgstr "Link порушує RFC 8288 §3, тому клієнти відкидають посилання, яких не можуть прочитати"

msgid "listed in the sitemap, yet no crawled page links here"
msgstr "є у sitemap, але жодна просканована сторінка не посилається сюди"

msgid "loads an accessibility overlay, which does not fix the page and gets in the way of assistive tools"
msgstr "завантажує накладку доступності, яка не виправляє сторінку й заважає допоміжним технологіям"

msgid "meta color-scheme should be normal, or scheme names such as light dark"
msgstr "meta color-scheme має бути normal або назвами схем, як-от light dark"

msgid "meta description repeats itself around a separator"
msgstr "мета-опис повторюється навколо роздільника"

msgid "meta description should be 50–160 characters"
msgstr "мета-опис має містити 50–160 символів"

msgid "meta viewport should set width=device-width and allow zoom"
msgstr "meta viewport має задавати width=device-width і дозволяти масштабування"

msgid "missing from the sitemap"
msgstr "відсутня у sitemap"

msgid "more than one stylesheet in <head> blocks rendering"
msgstr "більше одного аркуша стилів у <head> блокує відображення"

msgid "no <link rel=icon> in the head"
msgstr "у head немає <link rel=icon>"

msgid "no <title>"
msgstr "немає <title>"

msgid "no Cache-Control directive on an HTML page"
msgstr "жодної директиви Cache-Control на HTML-сторінці"

msgid "no Content-Digest or Repr-Digest lets a client check the body"
msgstr "без Content-Digest чи Repr-Digest клієнт не може перевірити тіло"

msgid "no enforced Content-Security-Policy, in a header or a <meta>"
msgstr "немає чинної Content-Security-Policy ні в заголовку, ні в <meta>"

msgid "no ETag or Last-Modified to revalidate against"
msgstr "немає ETag чи Last-Modified для повторної перевірки"

msgid "no link with rel=privacy-policy"
msgstr "немає посилання з rel=privacy-policy"

msgid "no meta description"
msgstr "немає мета-опису"

msgid "no meta theme-color"
msgstr "немає meta theme-color"

msgid "no Permissions-Policy header naming a feature"
msgstr "жоден заголовок Permissions-Policy не називає функції"

msgid "no Reporting-Endpoints header naming an endpoint"
msgstr "жоден заголовок Reporting-Endpoints не називає кінцевої точки"

msgid "no Server-Timing header shows where the server spent its time"
msgstr "жоден заголовок Server-Timing не показує, на що сервер витратив час"

msgid "no Speculation Rules script or header prefetches likely next pages"
msgstr "жоден скрипт чи заголовок Speculation Rules не попередньо завантажує ймовірні наступні сторінки"

msgid "og:description should be 50–200 characters"
msgstr "og:description має містити 50–200 символів"

msgid "og:image should be an absolute http(s) URL"
msgstr "og:image має бути абсолютним URL http(s)"

msgid "og:title should be 10–90 characters"
msgstr "og:title має містити 10–90 символів"

msgid "og:type should be an Open Graph type or namespace:type"
msgstr "og:type має бути типом Open Graph або namespace:type"

msgid "og:url should be an absolute http(s) URL"
msgstr "og:url має бути абсолютним URL http(s)"

msgid "one view emits too much CO2e by the Sustainable Web Design model, above the 0.209 g budget (rating C)"
msgstr "один перегляд випромінює забагато CO2e за моделлю Sustainable Web Design, понад бюджет 0,209 г (оцінка C)"

msgid "only a few pages of the site link here"
msgstr "сюди посилається лише кілька сторінок сайту"

msgid "pages share one <title>"
msgstr "кілька сторінок мають спільний <title>"

msgid "pages share one meta description"
msgstr "кілька сторінок мають спільний мета-опис"

msgid "pages share one og:description"
msgstr "кілька сторінок мають спільний og:description"

msgid "pages share one og:title"
msgstr "кілька сторінок мають спільний og:title"

msgid "Permissions-Policy breaks its structured-field grammar, so browsers ignore it"
msgstr "Permissions-Policy порушує граматику структурованого поля, тому браузери його ігнорують"

msgid "Priority breaks its structured-field grammar, so clients ignore it"
msgstr "Priority порушує граматику структурованого поля, тому клієнти його ігнорують"

msgid "reached through a temporary redirect"
msgstr "досягається через тимчасове переспрямування"

msgid "Referrer-Policy breaks the Referrer Policy tokens"
msgstr "Referrer-Policy порушує токени Referrer Policy"

msgid "Referrer-Policy should not leak full URLs"
msgstr "Referrer-Policy не має розкривати повні URL"

msgid "Reporting-Endpoints breaks its structured-field grammar, so browsers ignore it"
msgstr "Reporting-Endpoints порушує граматику структурованого поля, тому браузери його ігнорують"

msgid "Retry-After asks clients back too soon, which brings the load straight back to a server that is shedding it"
msgstr "Retry-After просить клієнтів повернутися занадто скоро, що одразу повертає навантаження серверу, який намагається його скинути"

msgid "Retry-After breaks RFC 9110 §10.2.3, so clients cannot tell when to retry"
msgstr "Retry-After порушує RFC 9110 §10.2.3, тому клієнти не знають, коли повторити запит"

msgid "Strict-Transport-Security breaks RFC 6797 §6.1, so browsers ignore it"
msgstr "Strict-Transport-Security порушує RFC 6797 §6.1, тому браузери його ігнорують"

msgid "Strict-Transport-Security should carry includeSubDomains"
msgstr "Strict-Transport-Security має містити includeSubDomains"

msgid "Strict-Transport-Security should carry max-age of 1000000 or more"
msgstr "Strict-Transport-Security має містити max-age від 1000000"

msgid "Sunset should be an HTTP-date"
msgstr "Sunset має бути HTTP-date"

msgid "takes more than 2 redirects to land"
msgstr "потребує понад 2 переспрямувань, щоб дійти до місця"

msgid "tdm-reservation should be 0 or 1"
msgstr "tdm-reservation має бути 0 або 1"

msgid "the browser console logged errors"
msgstr "консоль браузера зафіксувала помилки"

msgid "the canonical link exists only after JavaScript runs"
msgstr "канонічне посилання з’являється лише після виконання JavaScript"

msgid "the certificate carries an RSA key, where an EC key makes a smaller handshake"
msgstr "сертифікат містить ключ RSA, тоді як ключ EC робить рукостискання меншим"

msgid "the certificate chain is signed with SHA-1 or MD5"
msgstr "ланцюжок сертифікатів підписано за допомогою SHA-1 або MD5"

msgid "the first <img> is usually above the fold, and loading=lazy delays it"
msgstr "перше <img> зазвичай видно одразу, а loading=lazy його затримує"

msgid "the h1 exists only after JavaScript runs"
msgstr "h1 з’являється лише після виконання JavaScript"

msgid "the home page links no machine-readable alternate (feed, JSON, Markdown)"
msgstr "головна сторінка не посилається на машинозчитувану альтернативу (стрічку, JSON, Markdown)"

msgid "the home page links no NLWeb endpoint with rel=nlweb"
msgstr "головна сторінка не посилається на кінцеву точку NLWeb через rel=nlweb"

msgid "the home page links no RSS, Atom or JSON feed"
msgstr "головна сторінка не посилається на стрічку RSS, Atom чи JSON"

msgid "the meta description exists only after JavaScript runs"
msgstr "мета-опис з’являється лише після виконання JavaScript"

msgid "the path exposes the server technology in its extension"
msgstr "шлях розкриває технологію сервера у своєму розширенні"

msgid "the path has an empty segment"
msgstr "шлях містить порожній сегмент"

msgid "the path has uppercase letters, which a server may treat as another URL"
msgstr "шлях містить великі літери, які сервер може вважати іншим URL"

msgid "the raw HTML carries a share of the text the rendered page shows"
msgstr "сирий HTML містить частку тексту, який показує відображена сторінка"

msgid "the server should speak HTTP/2 or HTTP/3"
msgstr "сервер має підтримувати HTTP/2 або HTTP/3"

msgid "the title exists only after JavaScript runs"
msgstr "заголовок з’являється лише після виконання JavaScript"

msgid "the URL carries a session ID"
msgstr "URL містить ідентифікатор сеансу"

msgid "the URL is longer than 100 characters"
msgstr "URL довший за 100 символів"

msgid "TLS should be 1.2 or 1.3"
msgstr "TLS має бути 1.2 або 1.3"

msgid "URL path should be lowercase, with hyphens and no empty segment"
msgstr "шлях URL має бути малими літерами, з дефісами й без порожніх сегментів"

msgid "Use-As-Dictionary breaks its structured-field grammar, so clients ignore it"
msgstr "Use-As-Dictionary порушує граматику структурованого поля, тому клієнти його ігнорують"

msgid "Use-As-Dictionary needs a match=\"<URL pattern>\" member"
msgstr "Use-As-Dictionary потребує члена match=\"<шаблон URL>\""

msgid "Vary breaks RFC 9110 §12.5.5"
msgstr "Vary порушує RFC 9110 §12.5.5"

msgid "Vary: * makes the response uncacheable"
msgstr "Vary: * робить відповідь некешованою"

msgid "X-Content-Type-Options should be nosniff"
msgstr "X-Content-Type-Options має бути nosniff"

msgid "X-XSS-Protection should be absent or 0"
msgstr "X-XSS-Protection має бути відсутнім або 0"

msgid "no /llms.txt summarises the site for language models"
msgstr "жоден /llms.txt не підсумовує сайт для мовних моделей"

msgid "/llms.txt is malformed: {got}"
msgstr "/llms.txt неправильно сформовано: {got}"

msgid "/llms.txt has no /llms-full.txt twin carrying the whole content"
msgstr "/llms.txt не має двійника /llms-full.txt з усім вмістом"

msgid "/llms-full.txt is malformed: {got}"
msgstr "/llms-full.txt неправильно сформовано: {got}"

msgid "/llms.txt carries Markdown a renderer or agent misreads: {got}"
msgstr "/llms.txt містить Markdown, який рендерер або агент читає хибно: {got}"

msgid "/llms-full.txt carries Markdown a renderer or agent misreads: {got}"
msgstr "/llms-full.txt містить Markdown, який рендерер або агент читає хибно: {got}"

msgid "/.well-known/agent-card.json is malformed: {got}"
msgstr "/.well-known/agent-card.json неправильно сформовано: {got}"

msgid "/.well-known/ai-catalog.json is malformed: {got}"
msgstr "/.well-known/ai-catalog.json неправильно сформовано: {got}"

msgid "/.well-known/mcp/server-card.json is malformed: {got}"
msgstr "/.well-known/mcp/server-card.json неправильно сформовано: {got}"

msgid "/.well-known/agent-skills/index.json is malformed: {got}"
msgstr "/.well-known/agent-skills/index.json неправильно сформовано: {got}"

msgid "/okf/index.md is malformed: {got}"
msgstr "/okf/index.md неправильно сформовано: {got}"

msgid "/schemamap.xml is malformed: {got}"
msgstr "/schemamap.xml неправильно сформовано: {got}"

msgid "no Markdown source: neither a .md twin nor Accept: text/markdown answers with one"
msgstr "немає джерела Markdown: ні двійник .md, ні Accept: text/markdown не повертають його"

msgid "a cookie is set without the Secure flag"
msgstr "cookie встановлено без прапорця Secure"

msgid "a cookie is set without a SameSite attribute"
msgstr "cookie встановлено без атрибута SameSite"

msgid "a __Host- cookie lacks Secure or Path=/, or sets Domain, so browsers reject it"
msgstr "cookie __Host- не має Secure чи Path=/ або задає Domain, тому браузери її відхиляють"

msgid "a __Secure- cookie lacks Secure, so browsers reject it"
msgstr "cookie __Secure- не має Secure, тому браузери її відхиляють"

msgid "a SameSite=None cookie lacks Secure, so browsers reject it"
msgstr "cookie SameSite=None не має Secure, тому браузери її відхиляють"

msgid "a cookie outlives 400 days, which browsers cap"
msgstr "cookie живе понад 400 днів, а браузери це обмежують"

msgid "no carbon.txt discloses the site’s sustainability documents and providers"
msgstr "жоден carbon.txt не розкриває документів зі сталості та провайдерів сайту"

msgid "carbon.txt is malformed: {got}"
msgstr "carbon.txt неправильно сформовано: {got}"

msgid "carbon.txt names disclosures past their valid_until: {got}"
msgstr "carbon.txt називає розкриття, що минули свій valid_until: {got}"

msgid "carbon.txt was last updated {got} days ago, more than a year"
msgstr "carbon.txt востаннє оновлено {got} днів тому, понад рік"

msgid "a cookie is set without the HttpOnly flag"
msgstr "cookie встановлено без прапорця HttpOnly"

msgid "no HTTPS record, so a first visit learns h3 and ECH only from Alt-Svc, one connection late"
msgstr "немає запису HTTPS, тож перший візит дізнається про h3 і ECH лише з Alt-Svc, на одне з’єднання пізніше"

msgid "the HTTPS record and Alt-Svc disagree about h3 (got {got})"
msgstr "запис HTTPS і Alt-Svc розходяться щодо h3 ({got})"

msgid "ipv4hint or ipv6hint does not match the A and AAAA records"
msgstr "ipv4hint або ipv6hint не збігається із записами A та AAAA"

msgid "no CAA issue or issuewild record on the host or any parent, so any CA may issue for it"
msgstr "немає запису CAA issue чи issuewild на хості або будь-якому батьківському, тому будь-який ЦС може видати сертифікат"

msgid "CAA does not allow the CA that issued the served certificate (got {got})"
msgstr "CAA не дозволяє ЦС, що видав поданий сертифікат ({got})"

msgid "CAA names no iodef address for refused issuance reports"
msgstr "CAA не називає адреси iodef для звітів про відмову у видачі"

msgid "CAA marks a tag outside RFC 8659 critical, so a CA that does not know it refuses to issue at all (got {got})"
msgstr "CAA позначає критичним тег поза RFC 8659, тому ЦС, що його не знає, відмовляється видавати сертифікат ({got})"

msgid "no AAAA record, so the host is unreachable over IPv6"
msgstr "немає запису AAAA, тому хост недосяжний через IPv6"

msgid "the name resolves through {got} of CNAME hops"
msgstr "ім’я розв’язується через {got} переходів CNAME"

msgid "the name is a CNAME to a name that does not exist, open to takeover (got {got})"
msgstr "ім’я є CNAME на неіснуюче ім’я, відкрите для перехоплення ({got})"

msgid "the zone is not signed with DNSSEC"
msgstr "зону не підписано DNSSEC"

msgid "the zone is signed but fails validation, so every validating resolver answers SERVFAIL"
msgstr "зону підписано, але перевірка не проходить, тому кожен резолвер із перевіркою відповідає SERVFAIL"

msgid "the zone signs or digests with an algorithm RFC 8624 forbids"
msgstr "зона підписує або хешує алгоритмом, який забороняє RFC 8624"

msgid "less than a quarter of the host’s signature validity is left, so re-signing has stalled (got {got})"
msgstr "залишилося менше чверті строку дії підпису хоста, тож повторне підписання зупинилося ({got})"

msgid "NSEC3 uses extra iterations or a salt (got {got})"
msgstr "NSEC3 використовує додаткові ітерації або сіль ({got})"

msgid "the zone has {got} name servers, fewer than 2"
msgstr "зона має {got} серверів імен, менше ніж 2"

msgid "a name server is lame or the servers disagree on the SOA serial (got {got})"
msgstr "сервер імен непридатний або сервери розходяться щодо серійного номера SOA ({got})"

msgid "the name servers give {got} different answers for the host, so what a visitor reaches depends on which one their resolver asks"
msgstr "сервери імен дають {got} різних відповідей для хоста, тож те, до чого потрапить відвідувач, залежить від того, який із них спитає його резолвер"

msgid "the configured resolver answers the host differently from its name servers, a cached old answer or a split view"
msgstr "налаштований резолвер відповідає для хоста інакше, ніж його сервери імен: стара відповідь у кеші або розділене подання"

msgid "the compared resolvers disagree on whether the host resolves (got {got}); a SERVFAIL on a validating resolver alone points at DNSSEC"
msgstr "порівняні резолвери розходяться щодо того, чи розв’язується хост ({got}); SERVFAIL лише на резолвері з перевіркою вказує на DNSSEC"

msgid "the compared resolvers give {got} different answers for the host; geo-DNS does this on purpose, a stale or split view does not"
msgstr "порівняні резолвери дають {got} різних відповідей для хоста; гео-DNS робить це навмисно, застаріле чи розділене подання — ні"

msgid "some compared resolvers validate the signed zone and some do not (got {got})"
msgstr "одні з порівняних резолверів перевіряють підписану зону, а інші ні ({got})"

msgid "the parent zone delegates to other name servers than the zone’s own NS records, so resolvers reach a server the zone disowns (got {got})"
msgstr "батьківська зона делегує іншим серверам імен, ніж власні записи NS зони, тому резолвери потрапляють на сервер, який зона не визнає ({got})"

msgid "the zone apex is a CNAME to {got}, which cannot sit beside the apex’s SOA and NS records"
msgstr "вершина зони є CNAME на {got}, який не може бути поруч із записами SOA та NS вершини"

msgid "the SOA {field} is {got}, outside what RFC 1912 §2.2 recommends: refresh 1200–43200 s, retry below refresh, expire 1209600–2419200 s, minimum 300–86400 s, a listed name server as primary"
msgstr "{field} у SOA дорівнює {got}, поза рекомендаціями RFC 1912 §2.2: refresh 1200–43200 с, retry менше за refresh, expire 1209600–2419200 с, minimum 300–86400 с, первинний сервер зі списку серверів імен"

msgid "a record TTL sits outside 300 seconds to one day, two for NS; fine just before a migration, costly otherwise (got {got})"
msgstr "TTL запису лежить поза діапазоном від 300 секунд до доби, для NS — двох; доречно перед міграцією, а в інший час коштовно ({got})"

msgid "an authoritative name server answers recursive queries for any name, which lends it to amplification attacks and cache poisoning"
msgstr "авторитетний сервер імен відповідає на рекурсивні запити для будь-якого імені, що відкриває його для атак підсилення та отруєння кешу"

msgid "the domain registration expires in {got} days, and the site and its mail stop resolving when it lapses"
msgstr "реєстрація домену спливає через {got} днів, і сайт та його пошта перестануть розв’язуватися, коли вона мине"

msgid "the registration carries no transfer lock, so whoever takes over the registrar account can move the domain away (status {got})"
msgstr "реєстрація не має блокування переносу, тож хто заволодіє обліковим записом реєстратора, може забрати домен (статус {got})"

msgid "the name servers the registry lists differ from the zone’s own NS records"
msgstr "сервери імен, указані в реєстрі, відрізняються від власних записів NS зони"

msgid "every name server address sits in one /24 or /48"
msgstr "усі адреси серверів імен лежать в одній мережі /24 або /48"

msgid "no null MX, so senders fall back to the name’s A or AAAA address and retry mail it never takes for days (got {got})"
msgstr "немає нульового MX, тому відправники звертаються до адреси A чи AAAA імені й днями повторюють пошту, яку воно ніколи не приймає ({got})"

msgid "SPF is not a lone v=spf1 -all, so receivers cannot refuse mail forged from this name (got {got})"
msgstr "SPF не є самотнім v=spf1 -all, тому одержувачі не можуть відхиляти підроблену від цього імені пошту ({got})"

msgid "no DMARC policy of reject applies to the name, so receivers accept mail forged from it (got {got})"
msgstr "до імені не застосовується жодна політика DMARC reject, тому одержувачі приймають підроблену від нього пошту ({got})"

msgid "a null MX on a name that takes or sends mail, so senders may drop mail to it and receivers may refuse mail from it (got {got})"
msgstr "нульовий MX на імені, що приймає чи надсилає пошту, тож відправники можуть відкидати пошту до нього, а одержувачі — пошту від нього ({got})"

msgid "a name that takes or sends mail needs exactly one v=spf1 record, since none lets anyone send as it and two fail every check (got {got})"
msgstr "ім’я, що приймає чи надсилає пошту, потребує рівно одного запису v=spf1: за його відсутності ніхто не може надсилати від імені, а два провалюють кожну перевірку ({got})"

msgid "SPF does not end in -all or ~all, so receivers let any server send as this name (got {got})"
msgstr "SPF не закінчується на -all чи ~all, тому одержувачі дозволяють будь-якому серверу надсилати від цього імені ({got})"

msgid "the favicon is missing or broken: {got}"
msgstr "favicon відсутній або пошкоджений: {got}"

msgid "no usable SVG favicon: {got}"
msgstr "немає придатного SVG-favicon: {got}"

msgid "the Apple touch icon is missing or unfit: {got}"
msgstr "піктограма Apple touch відсутня або непридатна: {got}"

msgid "the Safari pinned tab icon is unusable; since Safari 12 an SVG rel=icon serves instead: {got}"
msgstr "піктограма закріпленої вкладки Safari непридатна; від Safari 12 замість неї править SVG rel=icon: {got}"

msgid "a Windows tile image or browserconfig.xml is broken: {got}"
msgstr "зображення плитки Windows або browserconfig.xml пошкоджено: {got}"

msgid "icons are not the size or type they declare: {got}"
msgstr "піктограми не мають розміру чи типу, які заявлено: {got}"

msgid "Lighthouse performance score is {got}, under 0.9"
msgstr "оцінка продуктивності Lighthouse дорівнює {got}, менше за 0,9"

msgid "Lighthouse accessibility score is {got}, under 0.9"
msgstr "оцінка доступності Lighthouse дорівнює {got}, менше за 0,9"

msgid "Lighthouse best-practices score is {got}, under 0.9"
msgstr "оцінка найкращих практик Lighthouse дорівнює {got}, менше за 0,9"

msgid "Lighthouse SEO score is {got}, under 0.9"
msgstr "SEO-оцінка Lighthouse дорівнює {got}, менше за 0,9"

msgid "LCP is {got} ms in the lab, over 2500 ms"
msgstr "LCP у лабораторії становить {got} мс, понад 2500 мс"

msgid "CLS is {got} in the lab, over 0.1"
msgstr "CLS у лабораторії становить {got}, понад 0,1"

msgid "TBT is {got} ms in the lab, over 200 ms"
msgstr "TBT у лабораторії становить {got} мс, понад 200 мс"

msgid "FCP is {got} ms in the lab, over 1800 ms"
msgstr "FCP у лабораторії становить {got} мс, понад 1800 мс"

msgid "the SPF record breaks the RFC 7208 grammar, so receivers treat it as a permanent error and ignore it (got {got})"
msgstr "запис SPF порушує граматику RFC 7208, тому одержувачі вважають це постійною помилкою й ігнорують його ({got})"

msgid "SPF needs {got} DNS lookups counting its includes, over the 10 RFC 7208 allows, so receivers fail it"
msgstr "SPF потребує {got} DNS-запитів разом з include, більше за 10, дозволених RFC 7208, тому одержувачі його провалюють"

msgid "SPF makes {got} lookups that find nothing, over the 2 RFC 7208 allows, so receivers fail it"
msgstr "SPF робить {got} запитів без результату, більше за 2, дозволені RFC 7208, тому одержувачі його провалюють"

msgid "SPF uses the ptr mechanism, which RFC 7208 says not to use, since it is slow and unreliable"
msgstr "SPF використовує механізм ptr, який RFC 7208 радить не вживати, бо він повільний і ненадійний"

msgid "SPF lists mechanisms after all, which receivers never reach (got {got})"
msgstr "SPF перелічує механізми після all, до яких одержувачі ніколи не доходять ({got})"

msgid "SPF repeats a mechanism, or carries a redirect that all makes unreachable (got {got})"
msgstr "SPF повторює механізм або містить redirect, який all робить недосяжним ({got})"

msgid "SPF includes or redirects to a name with no single SPF record, a permanent error to receivers (got {got})"
msgstr "SPF включає або переспрямовує на ім’я без єдиного запису SPF, що для одержувачів є постійною помилкою ({got})"

msgid "the name publishes {got} DMARC records, so receivers discard all of them"
msgstr "ім’я публікує {got} записів DMARC, тому одержувачі відкидають усі"

msgid "the DMARC record breaks the RFC 9989 grammar (got {got})"
msgstr "запис DMARC порушує граматику RFC 9989 ({got})"

msgid "the DMARC record sets no sp= policy although the domain serves subdomains, which then inherit p= silently"
msgstr "запис DMARC не задає політики sp=, хоча домен обслуговує піддомени, які тоді мовчки успадковують p="

msgid "the DMARC policy is in test mode, t=y or pct below 100, so receivers do not apply it to all mail"
msgstr "політика DMARC у тестовому режимі, t=y або pct менше за 100, тому одержувачі не застосовують її до всієї пошти"

msgid "a DMARC report address is not a mailto: URI, so no report reaches it (got {got})"
msgstr "адреса звітів DMARC не є URI mailto:, тому жоден звіт до неї не доходить ({got})"

msgid "DMARC sends reports to a domain that does not accept them, so receivers drop them (got {got})"
msgstr "DMARC надсилає звіти на домен, який їх не приймає, тому одержувачі їх відкидають ({got})"

msgid "no DKIM key found under any common selector; the probe list cannot be complete, so check your provider’s selector"
msgstr "ключ DKIM не знайдено за жодним поширеним селектором; перелік проб не може бути повним, тож перевірте селектор вашого провайдера"

msgid "a DKIM key record breaks the RFC 6376 grammar, so signatures under it fail (got {got})"
msgstr "запис ключа DKIM порушує граматику RFC 6376, тому підписи під ним не проходять ({got})"

msgid "a DKIM RSA key is shorter than the 1024 bits RFC 8301 requires, so receivers treat its signatures as absent (got {got})"
msgstr "ключ DKIM RSA коротший за 1024 біти, яких вимагає RFC 8301, тому одержувачі вважають його підписи відсутніми ({got})"

msgid "a DKIM RSA key is shorter than 2048 bits, which RFC 8301 recommends (got {got})"
msgstr "ключ DKIM RSA коротший за 2048 бітів, які радить RFC 8301 ({got})"

msgid "a DKIM key still carries the t=y testing flag, so receivers may ignore failed signatures (got {got})"
msgstr "ключ DKIM досі має тестовий прапорець t=y, тому одержувачі можуть ігнорувати невдалі підписи ({got})"

msgid "a DKIM selector publishes an empty key, which revokes it; fine for a retired selector, not for one in use (got {got})"
msgstr "селектор DKIM публікує порожній ключ, що його відкликає; нормально для виведеного селектора, але не для чинного ({got})"

msgid "an MX exchange has no A or AAAA record, so mail to it bounces (got {got})"
msgstr "обмінник MX не має запису A чи AAAA, тому пошта до нього повертається ({got})"

msgid "an MX exchange is a CNAME, which RFC 2181 forbids and some senders refuse (got {got})"
msgstr "обмінник MX є CNAME, що забороняє RFC 2181 і що деякі відправники відхиляють ({got})"

msgid "an MX exchange is an IP address, not a name, so senders cannot use it (got {got})"
msgstr "обмінник MX є IP-адресою, а не іменем, тому відправники не можуть його використати ({got})"

msgid "the MX set names an exchange more than once (got {got})"
msgstr "набір MX називає обмінник більше одного разу ({got})"

msgid "no MTA-STS record, so senders deliver over STARTTLS that an attacker on the path can strip"
msgstr "немає запису MTA-STS, тому відправники доставляють через STARTTLS, який зловмисник на шляху може вирізати"

msgid "the _mta-sts record breaks the RFC 8461 grammar, so senders ignore the policy (got {got})"
msgstr "запис _mta-sts порушує граматику RFC 8461, тому відправники ігнорують політику ({got})"

msgid "the MTA-STS policy file does not answer 200 as text/plain or does not parse, so senders ignore it (got {got})"
msgstr "файл політики MTA-STS не відповідає 200 як text/plain або не розбирається, тому відправники його ігнорують ({got})"

msgid "the MTA-STS policy is in {got} mode, so senders still deliver when TLS fails"
msgstr "політика MTA-STS у режимі {got}, тому відправники доставляють, навіть коли TLS не вдається"

msgid "the MTA-STS policy covers no mx: pattern for an exchange, so enforcing senders refuse to deliver to it (got {got})"
msgstr "політика MTA-STS не охоплює жодного шаблону mx: для обмінника, тому відправники, що її застосовують, відмовляються доставляти до нього ({got})"

msgid "the MTA-STS max_age is {got} seconds, under a day, so senders forget the policy between messages"
msgstr "max_age у MTA-STS становить {got} с, менше за добу, тому відправники забувають політику між листами"

msgid "no TLS-RPT record, so senders cannot report failed TLS deliveries"
msgstr "немає запису TLS-RPT, тому відправники не можуть повідомляти про невдалі доставки через TLS"

msgid "the TLS-RPT record breaks the RFC 8460 grammar (got {got})"
msgstr "запис TLS-RPT порушує граматику RFC 8460 ({got})"

msgid "the BIMI record breaks its grammar (got {got})"
msgstr "запис BIMI порушує свою граматику ({got})"

msgid "BIMI is published but DMARC does not quarantine or reject all mail, so no receiver shows the logo"
msgstr "BIMI опубліковано, але DMARC не ставить у карантин і не відхиляє всю пошту, тому жоден одержувач не показує логотип"

msgid "the BIMI logo does not load or breaks the SVG Tiny PS profile, so receivers show none (got {got})"
msgstr "логотип BIMI не завантажується або порушує профіль SVG Tiny PS, тому одержувачі не показують жодного ({got})"

msgid "the BIMI certificate the a= tag names does not load or is not a PEM certificate"
msgstr "сертифікат BIMI, названий тегом a=, не завантажується або не є сертифікатом PEM"

msgid "an exchange has no DNSSEC-signed TLSA record at _25._tcp, so senders cannot authenticate its certificate (got {got})"
msgstr "обмінник не має підписаного DNSSEC запису TLSA на _25._tcp, тому відправники не можуть автентифікувати його сертифікат ({got})"

msgid "an exchange does not offer STARTTLS on port 25, so mail to it travels in the clear (got {got})"
msgstr "обмінник не пропонує STARTTLS на порту 25, тому пошта до нього йде відкрито ({got})"

msgid "an exchange’s STARTTLS certificate does not validate for its name, so MTA-STS and DANE senders refuse it (got {got})"
msgstr "сертифікат STARTTLS обмінника не підтверджується для його імені, тому відправники з MTA-STS і DANE його відхиляють ({got})"

msgid "an exchange’s 220 banner names a host its address’s PTR does not, which some receivers score as spam (got {got})"
msgstr "банер 220 обмінника називає хост, якого не називає PTR його адреси, що деякі одержувачі оцінюють як спам ({got})"

msgid "an address sits in a route RPKI marks invalid, so networks that drop invalid routes cannot reach the site"
msgstr "адреса лежить у маршруті, який RPKI позначає недійсним, тому мережі, що відкидають недійсні маршрути, не можуть дістатися сайту"

msgid "an address sits in a prefix no ROA covers, so a hijack of its route cannot be told apart"
msgstr "адреса лежить у префіксі, якого не охоплює жоден ROA, тому перехоплення її маршруту не відрізнити"

msgid "a mail exchanger address has no PTR, or its PTR does not resolve back to it, so large mailbox providers refuse its mail"
msgstr "адреса поштового обмінника не має PTR, або її PTR не розв’язується назад до неї, тому великі поштові провайдери відхиляють її пошту"

msgid "the host and every name server sit in one autonomous system, so one network outage takes the site and its DNS down together (got {got})"
msgstr "хост і всі сервери імен розташовані в одній автономній системі, тому один збій мережі знімає сайт і його DNS разом ({got})"

msgid "a missing page answers {got}, not 404 or 410"
msgstr "відсутня сторінка відповідає {got}, а не 404 чи 410"

msgid "the not-found page is not plain HTML free of stack traces and server versions (got {got})"
msgstr "сторінка «не знайдено» не є чистим HTML без трас стека й версій сервера ({got})"

msgid "plain http does not redirect to https in one permanent hop (got {got}); deprecated, see origin/canonical-host/mismatch"
msgstr "звичайний http не переспрямовує на https одним постійним переходом ({got}); застаріло, див. origin/canonical-host/mismatch"

msgid "entry variants take more than one hop, or two not starting http to https on the same host: {got}"
msgstr "варіанти входу потребують більше одного переходу або двох, що не починаються з http на https на тому самому хості: {got}"

msgid "entry variants redirect with a temporary status or a meta refresh: {got}"
msgstr "варіанти входу переспрямовують із тимчасовим статусом або meta refresh: {got}"

msgid "entry variants lose the requested path or query on the way: {got}"
msgstr "варіанти входу гублять запитаний шлях чи запит дорогою: {got}"

msgid "entry variants are sent from https back to plain http: {got}"
msgstr "варіанти входу переспрямовуються з https назад на звичайний http: {got}"

msgid "no DNS answer for the entry host {got}; make sure that is deliberate"
msgstr "немає DNS-відповіді для хоста входу {got}; переконайтеся, що це навмисно"

msgid "/ lands on {got} different URLs depending on Accept-Language"
msgstr "/ веде на {got} різних URL залежно від Accept-Language"

msgid "/ is served only with {got}; offer br, zstd and gzip, each to the clients that ask for it"
msgstr "/ віддається лише з {got}; пропонуйте br, zstd і gzip кожному клієнтові, який про це просить"

msgid "/favicon.ico is not an image (got {got})"
msgstr "/favicon.ico не є зображенням ({got})"

msgid "a conditional request for the seed page answers {got}, not 304 Not Modified"
msgstr "умовний запит початкової сторінки відповідає {got}, а не 304 Not Modified"

msgid "a page answers 2xx with the same title under both trailing-slash forms: {got}"
msgstr "сторінка відповідає 2xx з тим самим заголовком і з кінцевою скісною рискою, і без неї: {got}"

msgid "a cross-domain policy file lets any origin read the site as its visitor: {got}"
msgstr "файл міждоменної політики дозволяє будь-якому origin читати сайт від імені відвідувача: {got}"

msgid "podcast artwork is missing or unfit: {got}"
msgstr "обкладинка подкасту відсутня або непридатна: {got}"

msgid "a third-party or tracking cookie is set on first load, before any interaction ({got})"
msgstr "сторонню або відстежувальну cookie встановлено під час першого завантаження, до будь-якої взаємодії ({got})"

msgid "scripts write localStorage or sessionStorage on first load, before any interaction ({got})"
msgstr "скрипти пишуть у localStorage чи sessionStorage під час першого завантаження, до будь-якої взаємодії ({got})"

msgid "an SSHFP record names a host key the SSH server does not present, so the record is stale after a key rotation or the connection was intercepted (got {got})"
msgstr "запис SSHFP називає ключ хоста, якого SSH-сервер не подає, тож запис застарів після ротації ключа або з’єднання перехопили ({got})"

msgid "the SSHFP records were not authenticated by DNSSEC, so an SSH client must not trust them: the zone is unsigned or the resolver does not validate"
msgstr "записи SSHFP не автентифіковано DNSSEC, тому SSH-клієнт не повинен їм довіряти: зону не підписано або резолвер не перевіряє"

msgid "the host answers SSH but publishes no SSHFP record, so a first connection is trust on first use"
msgstr "хост відповідає на SSH, але не публікує запису SSHFP, тож перше з’єднання спирається на довіру при першому використанні"

msgid "an SSHFP record names a DSA key or carries a SHA-1 digest with no SHA-256 one beside it (got {got})"
msgstr "запис SSHFP називає ключ DSA або має дайджест SHA-1 без SHA-256 поруч ({got})"

msgid "the server still accepts {got}, which RFC 6176, RFC 7568 and RFC 8996 retire"
msgstr "сервер досі приймає {got}, що виводять з обігу RFC 6176, RFC 7568 і RFC 8996"

msgid "the server accepts suites broken outright: {got}"
msgstr "сервер приймає набори, що зламані остаточно: {got}"

msgid "what the server negotiates leaves it open to {got}"
msgstr "те, що узгоджує сервер, залишає його відкритим до {got}"

msgid "the server accepts suites without forward secrecy, with CBC or with a 64-bit block: {got}"
msgstr "сервер приймає набори без прямої секретності, з CBC або з 64-бітним блоком: {got}"

msgid "forward secrecy covers {got} of the accepted suites, where “all” are expected"
msgstr "пряма секретність охоплює {got} із прийнятих наборів, а очікується “all”"

msgid "the server’s DHE prime has {got} bits, short of 2048"
msgstr "просте число DHE сервера має {got} біт, менше за 2048"

msgid "the server compresses TLS records, through which CRIME reads secrets"
msgstr "сервер стискає записи TLS, через що CRIME читає секрети"

msgid "the server does not answer renegotiation_info, so a renegotiation can be spliced into a session"
msgstr "сервер не відповідає на renegotiation_info, тому перепогодження можна вшити в сеанс"

msgid "the server lets the client pick a weak suite over a strong one"
msgstr "сервер дозволяє клієнтові обрати слабкий набір замість сильного"

msgid "the server accepts a needless fallback to an older version instead of refusing it"
msgstr "сервер приймає непотрібний відкат до старішої версії замість відмови"

msgid "the server offers {got} and no TLS 1.3"
msgstr "сервер пропонує {got} і не пропонує TLS 1.3"

msgid "the server does not send the intermediate certificates its chain needs, so clients that have not cached them fail"
msgstr "сервер не надсилає проміжних сертифікатів, потрібних його ланцюжкові, тому клієнти, що не кешували їх, зазнають збою"

msgid "the certificate names an OCSP responder but the server staples no response, so each client asks the CA"
msgstr "сертифікат називає OCSP-респондер, але сервер не прикріплює відповіді, тож кожен клієнт питає ЦС"

msgid "the server accepts TLS 1.3 early data, which an attacker can replay; non-idempotent requests must answer 425"
msgstr "сервер приймає ранні дані TLS 1.3, які зловмисник може відтворити; неідемпотентні запити мають відповідати 425"

msgid "no /.well-known/security.txt tells researchers how to report a vulnerability"
msgstr "жоден /.well-known/security.txt не підказує дослідникам, як повідомити про вразливість"

msgid "/.well-known/security.txt breaks RFC 9116: {got}"
msgstr "/.well-known/security.txt порушує RFC 9116: {got}"

msgid "/.well-known/security.txt expires in {got} days, not within the next year"
msgstr "/.well-known/security.txt спливає через {got} днів, а не протягом наступного року"

msgid "a crawled page asks for a password, but /.well-known/change-password leads nowhere"
msgstr "просканована сторінка запитує пароль, але /.well-known/change-password нікуди не веде"

msgid "/.well-known/gpc.json is malformed: {got}"
msgstr "/.well-known/gpc.json неправильно сформовано: {got}"

msgid "/.well-known/api-catalog is malformed: {got}"
msgstr "/.well-known/api-catalog неправильно сформовано: {got}"

msgid "/.well-known/openid-configuration is malformed: {got}"
msgstr "/.well-known/openid-configuration неправильно сформовано: {got}"

msgid "/.well-known/oauth-authorization-server is malformed: {got}"
msgstr "/.well-known/oauth-authorization-server неправильно сформовано: {got}"

msgid "/.well-known/oauth-protected-resource is malformed: {got}"
msgstr "/.well-known/oauth-protected-resource неправильно сформовано: {got}"

msgid "/.well-known/webauthn is malformed: {got}"
msgstr "/.well-known/webauthn неправильно сформовано: {got}"

msgid "/.well-known/apple-app-site-association is malformed: {got}"
msgstr "/.well-known/apple-app-site-association неправильно сформовано: {got}"

msgid "/.well-known/assetlinks.json is malformed: {got}"
msgstr "/.well-known/assetlinks.json неправильно сформовано: {got}"

msgid "/.well-known/nodeinfo is malformed: {got}"
msgstr "/.well-known/nodeinfo неправильно сформовано: {got}"

msgid "/.well-known/traffic-advice is malformed: {got}"
msgstr "/.well-known/traffic-advice неправильно сформовано: {got}"

msgid "/.well-known/tdmrep.json is malformed: {got}"
msgstr "/.well-known/tdmrep.json неправильно сформовано: {got}"

msgid "the crawl links /.well-known/ suffixes IANA has not registered: {got}"
msgstr "сканування посилається на суфікси /.well-known/, яких IANA не зареєструвала: {got}"

msgid "declared WebSub hub does not answer: {got}"
msgstr "оголошений хаб WebSub не відповідає: {got}"

msgid "head links announce this URL as a feed, it is {type}"
msgstr "посилання в head оголошують цей URL стрічкою, але він має тип {type}"

msgid "head links announce this URL as {announced}, it is {format}"
msgstr "посилання в head оголошують цей URL як {announced}, але він є {format}"

msgid "{count} of {total} pages advertise no feed while the rest do"
msgstr "{count} із {total} сторінок не оголошують стрічки, тоді як решта оголошує"

msgid "{format} feed answers a conditional request with 200 and an unchanged body instead of 304, so every reader downloads it in full on every poll"
msgstr "стрічка {format} відповідає на умовний запит 200 і незміненим тілом замість 304, тому кожен читач завантажує її повністю під час кожного опитування"

msgid "{format} feed caching works against its readers"
msgstr "кешування стрічки {format} працює проти її читачів"

msgid "{format} feed carries a date readers cannot parse"
msgstr "стрічка {format} містить дату, яку читачі не можуть розібрати"

msgid "{format} feed carries a relative URL"
msgstr "стрічка {format} містить відносний URL"

msgid "{format} feed carries elements RSS 2.0 does not define"
msgstr "стрічка {format} містить елементи, яких RSS 2.0 не визначає"

msgid "{format} feed carries markup or placeholders in an item title"
msgstr "стрічка {format} містить розмітку чи заповнювачі в заголовку запису"

msgid "{format} feed carries markup readers strip"
msgstr "стрічка {format} містить розмітку, яку читачі вилучають"

msgid "{format} feed carries summaries while the linked pages say far more"
msgstr "стрічка {format} містить анотації, тоді як сторінки, на які вона посилається, кажуть набагато більше"

msgid "{format} feed costs every poll more bytes than it should"
msgstr "стрічка {format} коштує під час кожного опитування більше байтів, ніж слід"

msgid "{format} feed dates items unlike the pages they link"
msgstr "стрічка {format} датує записи інакше, ніж сторінки, на які посилається"

msgid "{format} feed declares a language other than the pages advertising it"
msgstr "стрічка {format} оголошує іншу мову, ніж сторінки, що її рекламують"

msgid "{format} feed declares a language that is not a BCP 47 tag"
msgstr "стрічка {format} оголошує мову, яка не є тегом BCP 47"

msgid "{format} feed declares or decodes its encoding inconsistently"
msgstr "стрічка {format} оголошує чи розкодовує своє кодування непослідовно"

msgid "{format} feed delivers template placeholders or missing values to readers"
msgstr "стрічка {format} доставляє читачам заповнювачі шаблону чи відсутні значення"

msgid "{format} feed delivers unrendered Markdown or MDX to readers"
msgstr "стрічка {format} доставляє читачам нерендерені Markdown чи MDX"

msgid "{format} feed does not parse"
msgstr "стрічка {format} не розбирається"

msgid "{format} feed enclosures disagree with their host"
msgstr "вкладення стрічки {format} не збігаються з тим, що віддає їхній хост"

msgid "{format} feed escapes item content twice, so readers show tags and entities as text"
msgstr "стрічка {format} екранує вміст записів двічі, тому читачі показують теги й сутності як текст"

msgid "{format} feed has no stable Podcasting 2.0 GUID"
msgstr "стрічка {format} не має стабільного GUID Podcasting 2.0"

msgid "{format} feed holds HTML in a plain-text field"
msgstr "стрічка {format} зберігає HTML у полі простого тексту"

msgid "{format} feed is served with a type readers do not treat as a feed"
msgstr "стрічка {format} віддається з типом, який читачі не вважають стрічкою"

msgid "{format} feed is styled by an XSLT stylesheet; Chrome 158 ({date}) stops applying XSLT, so visitors there see raw XML"
msgstr "стрічка {format} оформлена таблицею стилів XSLT; Chrome 158 ({date}) перестає застосовувати XSLT, тому відвідувачі побачать там сирий XML"

msgid "{format} feed items are dated after the response, so readers sort them above everything else"
msgstr "записи стрічки {format} датовано пізніше за відповідь, тому читачі ставлять їх над усім іншим"

msgid "{format} feed items carry no stable identifier, so readers show them again as new"
msgstr "записи стрічки {format} не мають стабільного ідентифікатора, тому читачі показують їх знову як нові"

msgid "{format} feed lacks what its format requires"
msgstr "стрічці {format} бракує того, чого вимагає її формат"

msgid "{format} feed lacks what podcast directories require"
msgstr "стрічці {format} бракує того, чого вимагають каталоги подкастів"

msgid "{format} feed links images or pages by a relative URL, which breaks in every reader"
msgstr "стрічка {format} посилається на зображення чи сторінки відносним URL, що ламається в кожному читачі"

msgid "{format} feed links items away from their canonical URL"
msgstr "стрічка {format} відсилає записи геть від їхнього канонічного URL"

msgid "{format} feed links items to pages that fail or redirect"
msgstr "стрічка {format} посилає записи на сторінки, що дають збій або переспрямовують"

msgid "{format} feed looks stale"
msgstr "стрічка {format} виглядає застарілою"

msgid "{format} feed names a WebSub hub but no self URL to subscribe to"
msgstr "стрічка {format} називає хаб WebSub, але не має власного URL для підписки"

msgid "{format} feed names a guid that is not a URL while claiming it is a permalink"
msgstr "стрічка {format} називає guid, який не є URL, стверджуючи, що це постійне посилання"

msgid "{format} feed names a stylesheet browsers will not apply"
msgstr "стрічка {format} називає таблицю стилів, яку браузери не застосують"

msgid "{format} feed names an email field that is not `address (Name)`"
msgstr "стрічка {format} називає поле пошти, що не має вигляду `address (Name)`"

msgid "{format} feed names another URL as its self URL, not this one"
msgstr "стрічка {format} називає власним URL інший, а не цей"

msgid "{format} feed names archive pages readers cannot follow"
msgstr "стрічка {format} називає сторінки архіву, за якими читачі не можуть піти"

msgid "{format} feed names no self URL"
msgstr "стрічка {format} не називає власного URL"

msgid "{format} feed puts a tracking parameter into an item identifier"
msgstr "стрічка {format} вкладає параметр відстеження в ідентифікатор запису"

msgid "{format} feed repeats an item identifier"
msgstr "стрічка {format} повторює ідентифікатор запису"

msgid "{format} feed sends neither ETag nor Last-Modified, so every reader downloads it in full on every poll"
msgstr "стрічка {format} не надсилає ні ETag, ні Last-Modified, тому кожен читач завантажує її повністю під час кожного опитування"

msgid "{format} feed titles items unlike the pages they link"
msgstr "стрічка {format} називає записи інакше, ніж сторінки, на які посилається"

msgid "{format} feed uses an outdated JSON Feed form"
msgstr "стрічка {format} використовує застарілу форму JSON Feed"

msgid "{format} podcast feed locks with a value that is neither yes nor no"
msgstr "стрічка подкасту {format} блокується значенням, яке не є ні yes, ні no"

msgid "{format} podcast feed sets no podcast:locked, so any platform may import it"
msgstr "стрічка подкасту {format} не задає podcast:locked, тому будь-яка платформа може її імпортувати"

msgid "@font-face rules without font-display: swap, fallback or optional"
msgstr "правила @font-face без font-display: swap, fallback чи optional"

msgid "a 103 Early Hints preload is missing from the final Link header"
msgstr "попереднього завантаження з 103 Early Hints немає у фінальному заголовку Link"

msgid "a meta viewport entry is not a key and value browsers read, so they ignore it"
msgstr "запис meta viewport не є ключем і значенням, які читають браузери, тому вони його ігнорують"

msgid "a text {kind} is not served with br, gzip or zstd"
msgstr "текстовий {kind} віддається не через br, gzip чи zstd"

msgid "a {format} font is not WOFF2"
msgstr "шрифт {format} не є WOFF2"

msgid "a {format} image is above the weight limit"
msgstr "зображення {format} перевищує ліміт ваги"

msgid "a {format} image is smaller as {target}"
msgstr "зображення {format} важить менше як {target}"

msgid "a {format} image re-encodes smaller"
msgstr "зображення {format} перекодовується меншим"

msgid "a {kind} minifies smaller"
msgstr "{kind} мініфікується до меншого розміру"

msgid "an <img> below the fold without loading=lazy loads before the reader scrolls"
msgstr "<img> нижче першого екрана без loading=lazy завантажується, ще перш ніж читач прокрутить"

msgid "an <img> in the first viewport with loading=lazy waits for layout before loading"
msgstr "<img> на першому екрані з loading=lazy чекає на розкладку перед завантаженням"

msgid "an <img> ships far more pixels than the page renders"
msgstr "<img> передає значно більше пікселів, ніж показує сторінка"

msgid "an <img> without srcset ships over {oversize} the width it displays"
msgstr "<img> без srcset передає понад {oversize} ширини, яку показує"

msgid "an origin serves a render-blocking {kind} and nothing preconnects to it"
msgstr "origin віддає {kind}, що блокує відображення, і ніщо не робить preconnect до нього"

msgid "cross-origin {kind} without integrity"
msgstr "{kind} з іншого origin без integrity"

msgid "inline CSS uses features the browser targets “{query}” lack"
msgstr "вбудований CSS використовує можливості, яких бракує цільовим браузерам «{query}»"

msgid "meta theme-color is empty, so browsers ignore it"
msgstr "meta theme-color порожній, тому браузери його ігнорують"

msgid "meta theme-color is not a CSS color, so browsers ignore it"
msgstr "meta theme-color не є кольором CSS, тому браузери його ігнорують"

msgid "neither content-security-policy frame-ancestors nor x-frame-options refuses framing"
msgstr "ні frame-ancestors у content-security-policy, ні x-frame-options не забороняють вбудовування у фрейм"

msgid "rel={relation} warms an origin that no resource of the page loads"
msgstr "rel={relation} прогріває origin, з якого жоден ресурс сторінки не завантажується"

msgid "the link redirects elsewhere"
msgstr "посилання переспрямовує деінде"

msgid "the manifest does not parse"
msgstr "маніфест не розбирається"

msgid "the manifest icons lack sizes or a maskable icon"
msgstr "піктограмам маніфесту бракує розмірів або піктограми maskable"

msgid "the manifest is served or declared wrongly"
msgstr "маніфест віддається або оголошений неправильно"

msgid "the manifest lacks members, so browsers will not offer to install the site"
msgstr "маніфесту бракує членів, тому браузери не пропонуватимуть установити сайт"

msgid "the page answers {status}"
msgstr "сторінка відповідає {status}"

msgid "the page could not be fetched: {error}"
msgstr "сторінку не вдалося отримати: {error}"

msgid "the preconnect to a font origin lacks crossorigin, so fonts open a second connection"
msgstr "preconnect до origin шрифтів не має crossorigin, тому шрифти відкривають друге з’єднання"

msgid "the sitemap could not be read"
msgstr "sitemap не вдалося прочитати"

msgid "the sitemap media answers {status}"
msgstr "медіаресурс зі sitemap відповідає {status}"

msgid "the sitemap media could not be reached: {error}"
msgstr "медіаресурс зі sitemap недосяжний: {error}"

msgid "the style sheet uses features the browser targets “{query}” lack"
msgstr "таблиця стилів використовує можливості, яких бракує цільовим браузерам «{query}»"

msgid "{count} of {total} pages link no manifest while the rest do"
msgstr "{count} із {total} сторінок не посилаються на маніфест, тоді як решта посилається"

msgid "{kind} answers {status}"
msgstr "{kind} відповідає {status}"

msgid "{kind} could not be fetched: {error}"
msgstr "{kind} не вдалося отримати: {error}"

msgid "{kind} loads over http: on the https: pages that use it"
msgstr "{kind} завантажується через http: на сторінках https:, що його використовують"

msgid "{label} names another URL, not this page"
msgstr "{label} називає інший URL, а не цю сторінку"

msgid "fingerprinted {kind} sends a Cache-Control that breaks RFC 9111"
msgstr "{kind} з відбитком надсилає Cache-Control, що порушує RFC 9111"

msgid "immutable {kind} sends a Cache-Control that breaks RFC 9111"
msgstr "незмінний {kind} надсилає Cache-Control, що порушує RFC 9111"

msgid "fingerprinted {kind} is cached for less than a year"
msgstr "{kind} з відбитком кешується менш ніж на рік"

msgid "immutable {kind} is cached for less than a year"
msgstr "незмінний {kind} кешується менш ніж на рік"

msgid "{type} files are sent immutable at URLs that carry no hash or version, so caches serve a stale copy after the next publish"
msgstr "файли {type} надсилаються як immutable за URL без хешу чи версії, тож кеші віддають застарілу копію після наступної публікації"

msgid "{type} files are cached long at URLs that carry no hash or version, so caches serve a stale copy after the next publish"
msgstr "файли {type} довго кешуються за URL без хешу чи версії, тож кеші віддають застарілу копію після наступної публікації"

msgid "the style sheet has syntax errors, so browsers drop the rule or block each sits in"
msgstr "таблиця стилів має синтаксичні помилки, тому браузери відкидають правило чи блок, у якому кожна з них стоїть"

msgid "inline CSS has syntax errors, so browsers drop the rule or block each sits in"
msgstr "вбудований CSS має синтаксичні помилки, тому браузери відкидають правило чи блок, у якому кожна з них стоїть"

msgid "the style sheet names properties browsers do not know, so they drop those declarations"
msgstr "таблиця стилів називає властивості, яких браузери не знають, тому відкидають ці оголошення"

msgid "inline CSS names properties browsers do not know, so they drop those declarations"
msgstr "вбудований CSS називає властивості, яких браузери не знають, тому відкидають ці оголошення"

msgid "the style sheet carries values outside a property’s grammar, so browsers drop those declarations"
msgstr "таблиця стилів містить значення поза граматикою властивості, тому браузери відкидають ці оголошення"

msgid "inline CSS carries values outside a property’s grammar, so browsers drop those declarations"
msgstr "вбудований CSS містить значення поза граматикою властивості, тому браузери відкидають ці оголошення"

msgid "{kind}: a cookie is set without the Secure flag"
msgstr "{kind}: cookie встановлено без прапорця Secure"

msgid "{kind}: a cookie is set without the HttpOnly flag"
msgstr "{kind}: cookie встановлено без прапорця HttpOnly"

msgid "{kind}: a cookie is set without a SameSite attribute"
msgstr "{kind}: cookie встановлено без атрибута SameSite"

msgid "{kind}: a __Host- cookie lacks Secure or Path=/, or sets Domain, so browsers reject it"
msgstr "{kind}: cookie __Host- не має Secure чи Path=/ або задає Domain, тому браузери її відхиляють"

msgid "{kind}: a __Secure- cookie lacks Secure, so browsers reject it"
msgstr "{kind}: cookie __Secure- не має Secure, тому браузери її відхиляють"

msgid "{kind}: a SameSite=None cookie lacks Secure, so browsers reject it"
msgstr "{kind}: cookie SameSite=None не має Secure, тому браузери її відхиляють"

msgid "{kind}: a cookie outlives 400 days, which browsers cap"
msgstr "{kind}: cookie живе понад 400 днів, а браузери це обмежують"

msgid "the response body ended short of the bytes Content-Length declares"
msgstr "тіло відповіді закінчилося раніше за байти, які оголошує Content-Length"

msgid "the response body does not match Content-Length, or Content-Length is sent twice or beside chunked"
msgstr "тіло відповіді не збігається з Content-Length, або Content-Length надіслано двічі чи разом з chunked"

msgid "the response sends Content-Length beside Transfer-Encoding"
msgstr "відповідь надсилає Content-Length разом з Transfer-Encoding"

msgid "a 204 response carries Content-Length"
msgstr "відповідь 204 містить Content-Length"

msgid "{kind}: the response body ended short of the bytes Content-Length declares"
msgstr "{kind}: тіло відповіді закінчилося раніше за байти, які оголошує Content-Length"

msgid "{kind}: the response body does not match Content-Length, or Content-Length is sent twice or beside chunked"
msgstr "{kind}: тіло відповіді не збігається з Content-Length, або Content-Length надіслано двічі чи разом з chunked"

msgid "{kind}: the response sends Content-Length beside Transfer-Encoding"
msgstr "{kind}: відповідь надсилає Content-Length разом з Transfer-Encoding"

msgid "{kind}: a 204 response carries Content-Length"
msgstr "{kind}: відповідь 204 містить Content-Length"

msgid "Content-Signal should be search, ai-input or ai-train set to yes or no"
msgstr "Content-Signal має бути search, ai-input або ai-train зі значенням yes чи no"

msgid "JSON-LD blocks do not parse"
msgstr "блоки JSON-LD не розбираються"

msgid "User-agent: * is disallowed from every path, so no crawler indexes the site"
msgstr "User-agent: * заборонено в усіх шляхах, тому жоден краулер не індексує сайт"

msgid "a <div> or <span> takes clicks with no role, so neither keyboards nor screen readers find it"
msgstr "<div> або <span> приймає кліки без ролі, тому ні клавіатури, ні зчитувачі екрана його не знаходять"

msgid "a <video> without captions or subtitles"
msgstr "<video> без субтитрів"

msgid "a control shows nothing under forced colours: no visible text, and its icon is a gradient or a mask the system colours paint over"
msgstr "елемент керування нічого не показує за примусових кольорів: немає видимого тексту, а його піктограма — градієнт чи маска, яку системні кольори замальовують"

msgid "a focused element is hidden under fixed or sticky content"
msgstr "елемент у фокусі прихований під фіксованим чи липким вмістом"

msgid "a form field is set under {limit} px, so iOS Safari zooms in on focus"
msgstr "поле форми менше за {limit} px, тому iOS Safari збільшує масштаб у фокусі"

msgid "a link lacks the rel tokens declared for its host"
msgstr "посиланню бракує токенів rel, оголошених для його хоста"

msgid "a reference names a node its document never defines"
msgstr "посилання називає вузол, якого його документ ніколи не визначає"

msgid "a reference names a node its own page never defines"
msgstr "посилання називає вузол, якого його власна сторінка ніколи не визначає"

msgid "an <input> whose type does not match the autocomplete field, so phones show the wrong keyboard"
msgstr "<input>, тип якого не збігається з полем автозаповнення, тому телефони показують не ту клавіатуру"

msgid "an element is too faint to read in the dark scheme the page claims to support"
msgstr "елемент надто блідий, щоб його прочитати в темній схемі, яку сторінка заявляє підтримувати"

msgid "an element keeps its own text colours under forced colours"
msgstr "елемент зберігає власні кольори тексту за примусових кольорів"

msgid "an element loses its focus indicator under forced colours"
msgstr "елемент втрачає індикатор фокуса за примусових кольорів"

msgid "an element shows no visible change when focused"
msgstr "елемент не показує жодної видимої зміни у фокусі"

msgid "an element stays below 7:1 when the visitor asks for the more contrast the page answers"
msgstr "елемент лишається нижче за 7:1, коли відвідувач просить більшого контрасту, на який відповідає сторінка"

msgid "an interactive element is never reached by Tab"
msgstr "інтерактивний елемент ніколи не досягається клавішею Tab"

msgid "animations and videos keep moving although the visitor asks for reduced motion"
msgstr "анімації та відео не зупиняються, хоча відвідувач просить зменшити рух"

msgid "entry variants do not land on {canonical}, the canonical origin you configured"
msgstr "варіанти входу не потрапляють на {canonical}, канонічний origin, який ви налаштували"

msgid "entry variants do not land on {canonical}, the audited origin, since no canonical origin is configured"
msgstr "варіанти входу не потрапляють на {canonical}, перевірений origin, бо канонічний origin не налаштовано"

msgid "internal links carry rel=nofollow"
msgstr "внутрішні посилання мають rel=nofollow"

msgid "keyboard focus is trapped: Tab stops moving or cycles back"
msgstr "фокус клавіатури потрапив у пастку: Tab перестає рухатися або повертається назад"

msgid "lang and Content-Language name different languages"
msgstr "lang і Content-Language називають різні мови"

msgid "language switcher links do not declare the language they lead to"
msgstr "посилання перемикача мови не оголошують мови, на яку ведуть"

msgid "links say nothing about their targets out of context"
msgstr "посилання поза контекстом нічого не кажуть про свою мету"

msgid "no style answers `prefers-contrast: more`, so a visitor asking for more contrast sees the default colours"
msgstr "жоден стиль не відповідає на `prefers-contrast: more`, тому відвідувач, що просить більшого контрасту, бачить типові кольори"

msgid "one @id is typed {count} ways across the site"
msgstr "один @id має {count} різних типів на сайті"

msgid "schema.org terms are superseded"
msgstr "терміни schema.org замінено новими"

msgid "sitemap alternates differ from the page’s hreflang"
msgstr "альтернативи у sitemap відрізняються від hreflang сторінки"

msgid "structured data claims disagree with the page’s own tags"
msgstr "твердження структурованих даних розходяться з власними тегами сторінки"

msgid "structured data dates are malformed or contradictory"
msgstr "дати в структурованих даних неправильні або суперечливі"

msgid "structured data nodes lack properties their rich result requires"
msgstr "вузлам структурованих даних бракує властивостей, яких вимагає їхній розширений результат"

msgid "the breadcrumb item answers {status}"
msgstr "елемент хлібних крихт відповідає {status}"

msgid "the breadcrumb item redirects"
msgstr "елемент хлібних крихт переспрямовує"

msgid "the file names AI crawlers"
msgstr "файл називає краулери ШІ"

msgid "crawler access contradicts the content signals"
msgstr "доступ краулерів суперечить сигналам вмісту"

msgid "the edge refuses requests posing as crawlers the content signals welcome, as a verifying edge refuses any look-alike; check that its verified-bots setting lets the real crawlers through"
msgstr "периметр відхиляє запити, що видають себе за краулерів, яких сигнали вмісту вітають, як перевірний периметр відхиляє будь-яку імітацію; перевірте, чи його налаштування перевірених ботів пропускає справжніх краулерів"

msgid "the site refuses crawlers the content signals welcome"
msgstr "сайт відхиляє краулерів, яких сигнали вмісту вітають"

msgid "a page says noai or noimageai while the content signals allow AI training"
msgstr "сторінка каже noai або noimageai, хоча сигнали вмісту дозволяють навчання ШІ"

msgid "the first Tab stop is not a link to the main content"
msgstr "перша зупинка Tab не є посиланням на основний вміст"

msgid "the host names its software in {field}"
msgstr "хост називає своє програмне забезпечення в {field}"

msgid "the hreflang target answers {status}"
msgstr "ціль hreflang відповідає {status}"

msgid "the hreflang target redirects"
msgstr "ціль hreflang переспрямовує"

msgid "the page does not name back the pages listing it as an hreflang alternate"
msgstr "сторінка не називає у відповідь сторінок, що перелічують її як альтернативу hreflang"

msgid "the page sends deprecated headers"
msgstr "сторінка надсилає застарілі заголовки"

msgid "the title or description reads as another language than lang declares"
msgstr "заголовок або опис читаються іншою мовою, ніж оголошує lang"

