msgstr "Правило"

msgid "Rules this scan did not judge: its checks leave them out, or the site has nothing they apply to."
msgstr "Правила, яких ця перевірка не оцінювала: її набір їх не містить або на сайті немає до чого їх застосувати."

msgid "Rulesets: {names}"
msgstr "Набори правил: {names}"

msgid "Sampled pages: {count} of {sampled} ({share})"
msgstr "Сторінок у вибірці: {count} з {sampled} ({share})"

msgid "Scan"
msgstr "Перевірити"

msgid "Scan again"
msgstr "Перевірити знову"

msgid "Scan not found"
msgstr "Перевірку не знайдено"

msgid "Scanning…"
msgstr "Перевіряємо…"

msgid "Scans obey robots.txt and identify themselves as spiderlint. A finished report is public: its link and the site’s badge lead to it."
msgstr "Перевірки дотримуються robots.txt і називають себе spiderlint. Готовий звіт публічний: до нього ведуть його посилання та значок сайту."

msgid "Scans of this site are disabled on this instance."
msgstr "Перевірки цього сайту вимкнено на цьому сервері."

msgid "Script transfer"
msgstr "Передача скриптів"

msgid "Scripts"
msgstr "Скрипти"

msgid "Self-host"
msgstr "Розгорнути самостійно"

msgid "Self-host spiderlint: free software under the {license} licence."
msgstr "Розгорніть spiderlint самостійно: вільне програмне забезпечення за ліцензією {license}."

msgid "Server response time"
msgstr "Час відповіді сервера"

msgid "Severity"
msgstr "Рівень"

