msgid "Strict-Transport-Security should carry includeSubDomains, found {got}"
msgstr "Strict-Transport-Security debe llevar includeSubDomains, se encontró {got}"

msgid "Strict-Transport-Security should carry max-age of 1000000 or more, found {got}"
msgstr "Strict-Transport-Security debe llevar max-age de 1000000 o más, se encontró {got}"

msgid "Sunset should be an HTTP-date, found {got}"
msgstr "Sunset debe ser una HTTP-date, se encontró {got}"

msgid "takes more than 2 redirects to land ({got})"
msgstr "requiere más de 2 redirecciones para llegar ({got})"

