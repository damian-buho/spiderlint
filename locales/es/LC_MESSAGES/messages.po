msgstr "el icono de pestaña fijada de Safari es inutilizable; desde Safari 12 sirve en su lugar un rel=icon SVG: {got}"

msgid "a Windows tile image or browserconfig.xml is broken: {got}"
msgstr "una imagen de mosaico de Windows o browserconfig.xml está rota: {got}"

