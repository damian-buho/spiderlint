msgid "<html lang> should be a BCP 47 language tag"
msgstr "<html lang> debe ser una etiqueta de idioma BCP 47"

msgid "<meta charset> should declare UTF-8 within the first 1024 bytes"
msgstr "<meta charset> debe declarar UTF-8 dentro de los primeros 1024 bytes"

msgid "<meta name=tdm-reservation> should be 0 or 1"
msgstr "<meta name=tdm-reservation> debe ser 0 o 1"

msgid "<title> repeats itself around a separator"
msgstr "<title> se repite alrededor de un separador"

msgid "<title> should be 30–60 characters"
msgstr "<title> debe tener entre 30 y 60 caracteres"

msgid "a 503 should say when to retry with Retry-After"
msgstr "una respuesta 503 debe indicar cuándo reintentar con Retry-After"

msgid "Accept-CH breaks its structured-field grammar, so browsers ignore it"
msgstr "Accept-CH rompe su gramática de campo estructurado, así que los navegadores lo ignoran"

msgid "a compressed response should carry Vary: Accept-Encoding"
msgstr "una respuesta comprimida debe llevar Vary: Accept-Encoding"

msgid "a JSON-LD block does not parse"
msgstr "un bloque JSON-LD no se puede interpretar"

msgid "Alt-Svc breaks RFC 7838 §3, so clients never try the alternative"
msgstr "Alt-Svc incumple la RFC 7838 §3, así que los clientes nunca prueban la alternativa"

msgid "Alt-Svc should advertise h3"
msgstr "Alt-Svc debe anunciar h3"

msgid "an <img> has no alt attribute"
msgstr "un <img> no tiene atributo alt"

msgid "an <img> without width and height shifts the layout as it loads"
msgstr "un <img> sin width y height desplaza el diseño al cargar"

msgid "an article gives no publication date for its link preview"
msgstr "un artículo no da fecha de publicación para su vista previa de enlace"

msgid "an article names no author for its link preview"
msgstr "un artículo no nombra autor para su vista previa de enlace"

msgid "an article names no fediverse:creator account for Mastodon previews"
msgstr "un artículo no nombra una cuenta fediverse:creator para las vistas previas de Mastodon"

msgid "a page is more than 3 links away from the start page"
msgstr "una página está a más de 3 enlaces de la página de inicio"

msgid "a page links to no other page of the site"
msgstr "una página no enlaza a ninguna otra página del sitio"

msgid "a page of a staging or development site is indexable"
msgstr "una página de un sitio de pruebas o desarrollo es indexable"

msgid "a page served off the canonical origin is indexable; mark the staging twin noindex"
msgstr "una página servida fuera del origen canónico es indexable; marca su gemela de pruebas como noindex"

msgid "a page the sitemap lists says noindex, in <meta name=robots> or X-Robots-Tag"
msgstr "una página que lista el sitemap dice noindex, en <meta name=robots> o X-Robots-Tag"

msgid "a preloaded resource went unused"
msgstr "un recurso precargado no se usó"

msgid "a redirect does not say which component sent it with Redirect-By"
msgstr "una redirección no dice qué componente la envió con Redirect-By"

msgid "a right-to-left language should set <html dir=rtl>"
msgstr "un idioma de derecha a izquierda debe fijar <html dir=rtl>"

msgid "a script in <head> without async, defer or type=module blocks rendering"
msgstr "un script en <head> sin async, defer ni type=module bloquea el renderizado"

msgid "a URL with a query has no No-Vary-Search to say which parameters change the page"
msgstr "una URL con consulta no tiene No-Vary-Search que indique qué parámetros cambian la página"

msgid "Cache-Control breaks RFC 9111 §5.2, and caches ignore what they cannot read"
msgstr "Cache-Control incumple la RFC 9111 §5.2, y las cachés ignoran lo que no pueden leer"

msgid "Cache-Control no-store keeps the page out of the back/forward cache"
msgstr "Cache-Control no-store deja la página fuera de la caché de ir atrás/adelante"

msgid "Cache-Status breaks its structured-field grammar"
msgstr "Cache-Status rompe su gramática de campo estructurado"

msgid "canonical link should be an absolute URL"
msgstr "el enlace canónico debe ser una URL absoluta"

msgid "certificate expires within 14 days"
msgstr "el certificado vence en menos de 14 días"

msgid "certificate has expired"
msgstr "el certificado ha vencido"

msgid "certificate is not trusted"
msgstr "el certificado no es de confianza"

msgid "certificate key is weaker than RSA 2048 or EC P-256"
msgstr "la clave del certificado es más débil que RSA 2048 o EC P-256"

msgid "Cloudflare’s Email Address Obfuscation rewrites every address into a link only JavaScript decodes, so a visitor without JavaScript sees no address"
msgstr "la ofuscación de direcciones de correo de Cloudflare convierte cada dirección en un enlace que solo JavaScript descifra, así que un visitante sin JavaScript no ve ninguna dirección"

msgid "color-scheme names light and dark, but no theme-color pair carries a prefers-color-scheme media"
msgstr "color-scheme nombra claro y oscuro, pero ningún par de theme-color lleva un media prefers-color-scheme"

msgid "Content-Security-Policy allows eval() with 'unsafe-eval'"
msgstr "Content-Security-Policy permite eval() con 'unsafe-eval'"

msgid "Content-Security-Policy allows inline scripts with 'unsafe-inline' and no nonce or hash"
msgstr "Content-Security-Policy permite scripts en línea con 'unsafe-inline' y sin nonce ni hash"

msgid "Content-Security-Policy breaks CSP 3, and browsers drop what they cannot read"
msgstr "Content-Security-Policy incumple CSP 3, y los navegadores descartan lo que no pueden leer"

msgid "Content-Security-Policy lacks base-uri, so an injected <base> can redirect relative scripts"
msgstr "Content-Security-Policy no tiene base-uri, así que un <base> inyectado puede redirigir scripts relativos"

msgid "Content-Security-Policy lacks frame-ancestors, which only a header can carry"
msgstr "Content-Security-Policy no tiene frame-ancestors, que solo puede llevar una cabecera"

msgid "Content-Security-Policy lacks require-trusted-types-for 'script'"
msgstr "Content-Security-Policy no tiene require-trusted-types-for 'script'"

msgid "Content-Security-Policy lacks upgrade-insecure-requests"
msgstr "Content-Security-Policy no tiene upgrade-insecure-requests"

msgid "Content-Security-Policy loads scripts from any host through a * or scheme-only source"
msgstr "Content-Security-Policy carga scripts de cualquier host mediante una fuente * o solo de esquema"

msgid "Content-Security-Policy sets neither script-src nor default-src, so any script loads"
msgstr "Content-Security-Policy no fija script-src ni default-src, así que se carga cualquier script"

msgid "Content-Security-Policy should set object-src 'none'"
msgstr "Content-Security-Policy debe fijar object-src 'none'"

msgid "Content-Type breaks RFC 9110 §8.3.1"
msgstr "Content-Type incumple la RFC 9110 §8.3.1"

msgid "Cross-Origin-Embedder-Policy breaks its structured-field grammar, so browsers ignore it"
msgstr "Cross-Origin-Embedder-Policy rompe su gramática de campo estructurado, así que los navegadores la ignoran"

msgid "Cross-Origin-Embedder-Policy should be require-corp or credentialless"
msgstr "Cross-Origin-Embedder-Policy debe ser require-corp o credentialless"

msgid "Cross-Origin-Opener-Policy breaks its structured-field grammar, so browsers ignore it"
msgstr "Cross-Origin-Opener-Policy rompe su gramática de campo estructurado, así que los navegadores la ignoran"

msgid "Cross-Origin-Opener-Policy should be same-origin or same-origin-allow-popups"
msgstr "Cross-Origin-Opener-Policy debe ser same-origin o same-origin-allow-popups"

msgid "Cross-Origin-Resource-Policy should be same-origin, same-site or cross-origin"
msgstr "Cross-Origin-Resource-Policy debe ser same-origin, same-site o cross-origin"

msgid "Date should be an IMF-fixdate"
msgstr "Date debe ser una IMF-fixdate"

msgid "Deprecation should be @ and Unix seconds"
msgstr "Deprecation debe ser @ y segundos Unix"

msgid "hreflang alternates should include x-default"
msgstr "las alternativas hreflang deben incluir x-default"

msgid "internal links exist only after JavaScript runs"
msgstr "los enlaces internos solo existen tras ejecutar JavaScript"

msgid "Link breaks RFC 8288 §3, so clients drop the links they cannot read"
msgstr "Link incumple la RFC 8288 §3, así que los clientes descartan los enlaces que no pueden leer"

msgid "listed in the sitemap, yet no crawled page links here"
msgstr "figura en el sitemap, pero ninguna página rastreada enlaza aquí"

msgid "loads an accessibility overlay, which does not fix the page and gets in the way of assistive tools"
msgstr "carga una superposición de accesibilidad, que no arregla la página y estorba a las tecnologías de apoyo"

msgid "meta color-scheme should be normal, or scheme names such as light dark"
msgstr "meta color-scheme debe ser normal, o nombres de esquema como light dark"

msgid "meta description repeats itself around a separator"
msgstr "la meta descripción se repite alrededor de un separador"

