msgstr "sin Content-Digest ni Repr-Digest un cliente no puede comprobar el cuerpo"

msgid "no enforced Content-Security-Policy, in a header or a <meta>"
msgstr "no hay Content-Security-Policy aplicada, ni en cabecera ni en <meta>"

msgid "no ETag or Last-Modified to revalidate against"
msgstr "no hay ETag ni Last-Modified con que revalidar"

msgid "no link with rel=privacy-policy"
msgstr "no hay ningún enlace con rel=privacy-policy"

msgid "no meta description"
msgstr "no hay meta descripción"

msgid "no meta theme-color"
msgstr "no hay meta theme-color"

msgid "no Permissions-Policy header naming a feature"
msgstr "ninguna cabecera Permissions-Policy nombra una función"

