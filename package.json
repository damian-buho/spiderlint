{
  "name": "dbuho-spiderlint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site-wide linter for SEO tags, security headers, TLS and links",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "spiderlint": "src/cli.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/cli.ts",
    "lint": "eslint ./",
    "fix": "eslint ./ --fix",
    "test": "node --test --experimental-strip-types tests/**/*.test.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "cheerio": "1.0.0-rc.12",
    "crawlee": "3.18.1",
    "html-validate": "11.16.0",
    "http-cache-semantics": "4.2.0",
    "picomatch": "4.0.7",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "playwright": "1.63.0",
    "proper-lockfile": "4.1.2",
    "tldts": "7.4.13",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/http-cache-semantics": "4.2.0",
    "@types/node": "26.6.1",
    "@types/picomatch": "4.0.3",
    "@types/proper-lockfile": "4.1.4",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.2.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-tsdoc": "0.5.3",
    "eslint-plugin-unicorn": "75.0.0",
    "globals": "17.12.0",
    "prettier": "3.9.7",
    "typescript-eslint": "8.70.0"
  },
  "keywords": [
    "spiderlint",
    "linter",
    "crawler",
    "seo",
    "security-headers",
    "sarif"
  ],
  "author": {
    "name": "Damián Búho",
    "email": "damian.buho@proton.me",
    "url": "https://dbuho.me"
  },
  "maintainers": [
    {
      "name": "Damián Búho",
      "email": "damian.buho@proton.me",
      "url": "https://dbuho.me"
    }
  ],
  "repository": {
    "url": "ssh://git@kiota.ch/damian-buho/spiderlint.git",
    "type": "git"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ]
}
