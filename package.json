{
  "name": "dbuho-spiderlint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site-wide linter for SEO tags, security headers, TLS and links",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "spiderlint": "src/cli.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/cli.ts",
    "lint": "eslint ./",
    "fix": "eslint ./ --fix",
    "test": "node --test --experimental-strip-types tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@hono/node-server": "2.1.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@tgwf/co2": "0.19.0",
    "ajv": "8.20.0",
    "any-ascii": "0.3.3",
    "axe-core": "4.13.0",
    "bullmq": "6.3.9",
    "cheerio": "1.2.0",
    "crawlee": "3.18.1",
    "dns-packet": "5.6.1",
    "eld": "2.1.0",
    "esbuild": "0.28.2",
    "gettext-parser": "9.1.1",
    "hono": "4.13.9",
    "html-validate": "11.16.0",
    "htmlhint": "1.9.2",
    "http-cache-semantics": "4.2.0",
    "ioredis": "6.0.0",
    "lighthouse": "13.5.0",
    "log-update": "8.0.0",
    "marked": "18.0.14",
    "picomatch": "4.0.7",
    "pino": "10.3.1",
    "pino-opentelemetry-transport": "4.0.2",
    "pino-pretty": "13.1.3",
    "playwright": "1.63.0",
    "proper-lockfile": "4.1.2",
    "proxy-chain": "3.0.1",
    "saxes": "6.0.0",
    "sharp": "0.35.4",
    "smol-toml": "1.9.0",
    "structured-headers": "2.1.0",
    "svgo": "4.1.0",
    "tldts": "7.4.15",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/dns-packet": "5.6.5",
    "@types/gettext-parser": "9.0.0",
    "@types/http-cache-semantics": "4.2.0",
    "@types/node": "26.6.3",
    "@types/picomatch": "4.0.3",
    "@types/proper-lockfile": "4.1.4",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.4.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-tsdoc": "0.5.3",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "keywords": [
    "spiderlint",
    "linter",
    "crawler",
    "seo",
    "security-headers",
    "sarif"
  ],
  "author": {
    "email": "damian.buho@proton.me",
    "name": "Damián Búho",
    "url": "https://dbuho.me"
  },
  "maintainers": [
    {
      "email": "damian.buho@proton.me",
      "name": "Damián Búho",
      "url": "https://dbuho.me"
    }
  ],
  "repository": {
    "type": "git",
    "url": "ssh://git@kiota.ch/damian-buho/spiderlint.git"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ]
}
